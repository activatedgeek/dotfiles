#!/usr/bin/env bash

#MISE description="Delete OpenCode sessions and stale archived Paseo agents"
#MISE quiet=true

#USAGE flag "--dry-run" help="Print sessions without deleting them."

set -uo pipefail

for required_command in paseo opencode jq comm sort; do
    if ! command -v "${required_command}" >/dev/null 2>&1; then
        echo "[ERROR] Required command not found: ${required_command}" >&2
        exit 1
    fi
done

if ! paseo_home="$(paseo daemon status --json | jq -er '.home | select(type == "string" and length > 0)')"; then
    echo "[ERROR] Could not determine PASEO_HOME from the local daemon." >&2
    exit 1
fi

shopt -s nullglob
deleted_count=0
deleted_agent_count=0
failed_count=0

if ! opencode_sessions="$(opencode session list --format json)"; then
    echo "[ERROR] Could not list OpenCode sessions." >&2
    exit 1
fi

while IFS= read -r agent_id; do
    [[ -z "${agent_id}" ]] && continue

    agent_records=("${paseo_home}"/agents/*/"${agent_id}.json")
    if [[ ${#agent_records[@]} -ne 1 ]]; then
        echo "[ERROR] Expected one record for archived Paseo agent ${agent_id}, found ${#agent_records[@]}." >&2
        failed_count=$((failed_count + 1))
        continue
    fi

    agent_record="${agent_records[0]}"
    provider="$(jq -r '.provider // empty' "${agent_record}")"
    if [[ "${provider}" != "opencode" ]]; then
        echo "[SKIP] ${agent_id} uses provider ${provider:-unknown}."
        continue
    fi

    session_id="$(jq -r '.persistence.sessionId // .runtimeInfo.sessionId // empty' "${agent_record}")"
    if [[ -z "${session_id}" ]]; then
        echo "[ERROR] Archived OpenCode agent ${agent_id} has no session ID." >&2
        failed_count=$((failed_count + 1))
        continue
    fi

    if ! jq -e --arg session_id "${session_id}" 'any(.[]; .id == $session_id)' <<<"${opencode_sessions}" >/dev/null; then
        if [[ "${usage_dry_run:-false}" == "true" ]]; then
            echo "[DRY RUN] Delete Paseo agent ${agent_id}; OpenCode session ${session_id} does not exist."
        elif paseo agent delete "${agent_id}" >/dev/null; then
            echo "[DELETED] Paseo agent ${agent_id}; OpenCode session ${session_id} did not exist."
            deleted_agent_count=$((deleted_agent_count + 1))
        else
            echo "[ERROR] Failed to delete Paseo agent ${agent_id} with missing OpenCode session ${session_id}." >&2
            failed_count=$((failed_count + 1))
        fi
        continue
    fi

    if [[ "${usage_dry_run:-false}" == "true" ]]; then
        echo "[DRY RUN] ${agent_id} -> ${session_id}"
        continue
    fi

    if opencode session delete "${session_id}"; then
        echo "[DELETED] ${agent_id} -> ${session_id}"
        deleted_count=$((deleted_count + 1))
    else
        echo "[ERROR] Failed to delete OpenCode session ${session_id} for Paseo agent ${agent_id}." >&2
        failed_count=$((failed_count + 1))
    fi
done < <(
    comm -23 \
        <(paseo agent ls --all --global --json | jq -r '.[].id' | sort) \
        <(paseo agent ls --global --json | jq -r '.[].id' | sort)
)

if [[ "${usage_dry_run:-false}" != "true" ]]; then
    echo "Deleted ${deleted_count} OpenCode session(s)."
    echo "Deleted ${deleted_agent_count} stale Paseo agent(s)."
fi

if [[ ${failed_count} -gt 0 ]]; then
    echo "[ERROR] ${failed_count} archived agent(s) could not be processed." >&2
    exit 1
fi
