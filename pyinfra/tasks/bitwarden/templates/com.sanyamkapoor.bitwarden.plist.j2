<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sanyamkapoor.bitwarden</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>BW_SESSION="$("{{ bw_path | e }}" unlock --passwordfile "{{ password_path | e }}" --raw)" exec "{{ bw_path | e }}" export --format zip --output "{{ backup_path | e }}"</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>{{ stdout_path }}</string>
    <key>StandardErrorPath</key>
    <string>{{ stdout_path }}</string>

    <key>Umask</key>
    <string>077</string>
</dict>
</plist>
