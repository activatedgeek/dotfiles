[Unit]
Description=OpenChamber
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:%h/store/.mamba/bin
ExecStart=/bin/sh -ec 'password="$$(cat %h/.config/opencode/.pass)"; export OPENCODE_SERVER_USERNAME="%u" OPENCODE_SERVER_PASSWORD="$$password" OPENCHAMBER_UI_PASSWORD="$$password"; exec npx -y @openchamber/web@latest --no-daemon --api-only --lan --port 42424'
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure

[Install]
WantedBy=default.target
