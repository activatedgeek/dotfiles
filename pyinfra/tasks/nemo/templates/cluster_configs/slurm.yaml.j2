ssh_tunnel:
  host: {{ ssh_tunnel_host }}
  port: {{ ssh_tunnel_port }}
  user: {{ ssh_user }}
  identity: /home/{{ ssh_user }}/.ssh/config.d/nvda/id_ed25519
  job_dir: /home/{{ ssh_user }}/store/.nemo_run
  pre_command: HEADLESS=1 source ~/.bash_profile

nmux:
  transport: direct
{% if sbatch_partitions.gpu_interactive is defined %}
  interactive:
    partition: {{ sbatch_partitions.gpu_interactive.partition }}
{% if sbatch_partitions.gpu_interactive.qos is defined %}
    qos: {{ sbatch_partitions.gpu_interactive.qos }}
{% endif %}
    default_walltime: "{{ sbatch_partitions.gpu_interactive.time }}"
    max_walltime: "{{ sbatch_partitions.gpu_interactive.time }}"
{% endif %}

executor: slurm
account: {{ sbatch_account }}
mail_type: FAIL
partition: {{ sbatch_partitions.gpu.partition }}
cpu_partition: {{ sbatch_partitions.cpu.partition if sbatch_partitions.cpu is defined else sbatch_partitions.gpu.partition }}
timeouts:
  {% for _, partition in sbatch_partitions.items() %}
  {{ partition.partition }}: {{ partition.time }}
  {% endfor %}

{% if sbatch_partitions.gpu.overrides is defined and sbatch_partitions.gpu.overrides.gpus_per_node == -1 %}
disable_gpus_per_node: True
{% endif %}
